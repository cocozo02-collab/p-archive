{
  "name": "p-archive-mobile",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "catalog": "node scripts/copy-catalog.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "sync": "npm run catalog && npm run build && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
