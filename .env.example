# .env로 복사해서 채운다. .env는 .gitignore에 들어 있다.
# 비워 두면 스크립트가 실행할 때 입력받는다.
PIU_ID=
PIU_PASSWORD=

# PIU Scores(piuscores.arroweclip.se) 나의 계정 > API 탭의 개인 토큰. 곡/채보 목록 동기화에 쓴다.
PIU_SCORES_TOKEN=

# piugame.com 요청 사이 최소 간격(초). 1.0 미만으로 설정해도 1.0이 적용된다.
PIU_REQUEST_DELAY=1.5

# 경로(프로젝트 루트 기준 상대 경로 가능). 비워 두면 기본값을 쓴다.
# DATA_DIR=data
# DB_PATH=data/p-archive.db
# PIU_SCORES_BASE_URL=https://piuscores.arroweclip.se
